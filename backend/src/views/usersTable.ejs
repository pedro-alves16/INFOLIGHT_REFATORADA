<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>USUÁRIOS ADMIN</title>
</head>
<body>
    <h1>OS USUÁRIOS CADASTRADOS SÃO: </h1>
    <table style="border-spacing: 20px;">
    <tr >
        <th>Nome</th>
        <th>Email</th>
    </tr>

    <% data.forEach(user => { %>
        <tr>
            <td><%= user.userName %></td>
            <td><%= user.email %></td>
        </tr>
    <% }) %>
</table>
</body>
</html>